generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Estados del flujo editorial:
//   INGESTED  -> llegó del RSS, todavía sin nota generada por IA
//   DRAFT     -> la IA generó la nota curada, espera revisión humana
//   APPROVED  -> aprobada por un humano, visible en el sitio público
//   REJECTED  -> descartada
enum ArticleStatus {
  INGESTED
  DRAFT
  APPROVED
  REJECTED
}

model Article {
  id       String @id @default(cuid())
  guid     String @unique // GUID del feed, para deduplicar
  feedUrl  String
  sourceName String
  sourceUrl  String // link a la nota original (atribución)

  originalTitle   String
  originalContent String @db.Text
  // Imagen que trae el feed. Solo referencia para el editor: NO se publica
  // (las fotos de agencias tienen copyright). El editor carga imageUrl propia.
  originalImageUrl String?

  // Contenido curado (generado por IA, editable por el humano)
  title    String?
  summary  String? @db.Text
  content  String? @db.Text
  category String?
  slug     String? @unique
  imageUrl String? // imagen propia/stock elegida por el editor

  status      ArticleStatus @default(INGESTED)
  fetchedAt   DateTime      @default(now())
  publishedAt DateTime?
  reviewedAt  DateTime?

  @@index([status, publishedAt])
}
