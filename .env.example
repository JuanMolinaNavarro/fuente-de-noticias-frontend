# URL de la API NestJS (fuente-de-noticias-backend). Privada: la usa sólo el
# servidor de Next (Server Components y Server Actions), sin NEXT_PUBLIC_,
# así el browser nunca habla directo con el backend (patrón BFF).
API_URL="http://localhost:4000/api/v1"

# URL pública del sitio (sin barra final). Se usa para URLs canónicas,
# Open Graph, sitemap.xml y rss.xml. En producción: https://tu-dominio.com
SITE_URL="http://localhost:3000"
